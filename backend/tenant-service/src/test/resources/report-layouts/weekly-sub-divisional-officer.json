{
  "numberSections": true,
  "header": [
    { "type": "TITLE", "text": "Weekly Water Service Situation Report" },
    { "type": "SUBTITLE", "text": "(SDO) — Auto generated by JalSoochak" },
    { "type": "SPACER" },
    { "type": "FIELD", "label": "Sub-Divisional Officer: ", "value": "{officerName}" },
    { "type": "FIELD", "label": "Date: ", "value": "{generatedDate}" },
    { "type": "FIELD", "label": "Reporting Period: ",
      "value": "{weekStartDayName} {weekStart} to {weekEndDayName} {weekEnd}" },
    { "type": "SPACER" },
    { "type": "DASHBOARD_LINK", "prefix": "Visit JalSoochak Dashboard at ", "suffix": " for more insights" }
  ],
  "sections": [
    {
      "type": "SUMMARY",
      "title": "Summary",
      "columns": [
        { "field": "LABEL", "label": "KPI", "width": 40 },
        { "field": "CURRENT", "label": "{weekStart} to {weekEnd}", "width": 22 },
        { "field": "PREVIOUS", "label": "{previousWeekStart} to {previousWeekEnd}", "width": 22 },
        { "field": "TREND", "label": "Trend", "width": 16 }
      ],
      "rows": [
        { "kpi": "TOTAL_SCHEMES", "label": "Total Handed-Over Schemes" },
        { "kpi": "SCHEMES_SUPPLYING", "label": "Schemes Supplying Water (>=4 days in the week)" },
        { "kpi": "SCHEMES_NOT_SUPPLYING", "label": "Schemes Not Supplying Water (0 days in the week)" },
        { "kpi": "SCHEMES_LOW_LPCD", "label": "Schemes With Supply <=15 LPCD (average)" },
        { "kpi": "AVG_LPCD", "label": "Average LPCD*" }
      ],
      "footnotes": [
        "* of schemes that have supplied water",
        "Scheme totals reflect current mappings; both columns move if schemes are reassigned."
      ]
    },
    {
      "type": "OFFICER_PERFORMANCE",
      "title": "Section Officers Performance",
      "emptyText": "None",
      "columns": [
        { "field": "SERIAL_NO", "label": "S.No.", "width": 5 },
        { "field": "OFFICER_NAME", "label": "Section Officer Name", "width": 19 },
        { "field": "OFFICER_MOBILE", "label": "SO Mobile No.", "width": 15 },
        { "field": "TOTAL_SCHEMES", "label": "Total Schemes", "width": 10 },
        { "field": "SCHEMES_SUPPLYING", "label": "Schemes Supplying Water (>=4 days)", "width": 15 },
        { "field": "SCHEMES_NOT_SUPPLYING", "label": "Schemes Not Supplying Water (0 days)", "width": 13 },
        { "field": "SCHEMES_LOW_LPCD", "label": "Schemes with Supply <=15 LPCD", "width": 12 },
        { "field": "AVG_LPCD", "label": "Average LPCD*", "width": 11 }
      ],
      "footnotes": [
        "* of schemes that have supplied water",
        "Each officer's figures cover only the schemes they share with you."
      ]
    },
    {
      "type": "SCHEME_LIST",
      "list": "NO_SUPPLY",
      "title": "List of Schemes with No Supply (zero days)",
      "emptyText": "None",
      "columns": [
        { "field": "SERIAL_NO", "label": "S. No", "width": 5 },
        { "field": "SECTION_OFFICER_NAMES", "label": "SO Name", "width": 15 },
        { "field": "SECTION_OFFICER_MOBILES", "label": "SO Phone Number", "width": 14 },
        { "field": "SCHEME_NAME", "label": "Scheme Name", "width": 18 },
        { "field": "VILLAGES", "label": "Village Name", "width": 14 },
        { "field": "PUMP_OPERATOR_NAMES", "label": "Jal Mitra Name", "width": 16 },
        { "field": "PUMP_OPERATOR_MOBILES", "label": "Jal Mitra Phone", "width": 18 }
      ]
    },
    {
      "type": "SCHEME_LIST",
      "list": "LOW_LPCD",
      "title": "List of Schemes with <=15 LPCD supply over the Week",
      "emptyText": "None",
      "columns": [
        { "field": "SERIAL_NO", "label": "S. No", "width": 5 },
        { "field": "SECTION_OFFICER_NAMES", "label": "SO Name", "width": 15 },
        { "field": "SECTION_OFFICER_MOBILES", "label": "SO Phone Number", "width": 14 },
        { "field": "SCHEME_NAME", "label": "Scheme Name", "width": 18 },
        { "field": "VILLAGES", "label": "Village Name", "width": 14 },
        { "field": "PUMP_OPERATOR_NAMES", "label": "Jal Mitra Name", "width": 16 },
        { "field": "PUMP_OPERATOR_MOBILES", "label": "Jal Mitra Phone", "width": 18 }
      ]
    }
  ],
  "footer": [
    { "type": "SUPPORT_CONTACT", "text": "For support, contact {supportPhone}" }
  ]
}
