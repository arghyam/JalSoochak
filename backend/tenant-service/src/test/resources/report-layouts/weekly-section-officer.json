{
  "numberSections": true,
  "header": [
    { "type": "TITLE", "text": "Weekly Water Service Situation Report" },
    { "type": "SUBTITLE", "text": "(Section Officer) — Auto generated by JalSoochak" },
    { "type": "SPACER" },
    { "type": "FIELD", "label": "Officer: ", "value": "{officerName}" },
    { "type": "FIELD", "label": "Date: ", "value": "{generatedDate}" },
    { "type": "FIELD", "label": "Reporting Period: ",
      "value": "{weekStartDayName} {weekStart} to {weekEndDayName} {weekEnd}" },
    { "type": "SPACER" },
    { "type": "DASHBOARD_LINK", "prefix": "Visit JalSoochak Dashboard at ", "suffix": " for more insights" }
  ],
  "sections": [
    {
      "type": "SUMMARY",
      "title": "Summary",
      "columns": [
        { "field": "LABEL", "label": "KPI", "width": 40 },
        { "field": "CURRENT", "label": "{weekStart} to {weekEnd}", "width": 22 },
        { "field": "PREVIOUS", "label": "{previousWeekStart} to {previousWeekEnd}", "width": 22 },
        { "field": "TREND", "label": "Trend", "width": 16 }
      ],
      "rows": [
        { "kpi": "TOTAL_SCHEMES", "label": "Total Schemes" },
        { "kpi": "SCHEMES_SUPPLYING", "label": "Schemes Supplying Water (for minimum 1 day in the week)" },
        { "kpi": "SCHEMES_NOT_SUPPLYING", "label": "Schemes Not Supplying Water at all" },
        { "kpi": "AVG_LPCD", "label": "Average LPCD*" }
      ],
      "footnotes": [
        "* of schemes that have supplied water",
        "Scheme totals reflect current mappings; both columns move if schemes are reassigned."
      ]
    },
    {
      "type": "SCHEME_LIST",
      "list": "NO_SUPPLY",
      "title": "List of Schemes With no Supply (the whole week)",
      "emptyText": "None",
      "columns": [
        { "field": "SERIAL_NO", "label": "S. No.", "width": 8 },
        { "field": "SCHEME_NAME", "label": "Scheme Name", "width": 40 },
        { "field": "PUMP_OPERATOR_NAMES", "label": "Jal Mitra", "width": 28 },
        { "field": "PUMP_OPERATOR_MOBILES", "label": "Jal Mitra Phone Number", "width": 24 }
      ]
    },
    {
      "type": "SCHEME_LIST",
      "list": "LOW_SUPPLY_DAYS",
      "title": "List of Schemes With 1 to 3 days of supply",
      "emptyText": "None",
      "columns": [
        { "field": "SERIAL_NO", "label": "S. No.", "width": 8 },
        { "field": "SCHEME_NAME", "label": "Scheme Name", "width": 40 },
        { "field": "PUMP_OPERATOR_NAMES", "label": "Jal Mitra", "width": 28 },
        { "field": "PUMP_OPERATOR_MOBILES", "label": "Jal Mitra Phone Number", "width": 24 }
      ]
    },
    {
      "type": "SCHEME_LIST",
      "list": "LOW_LPCD",
      "title": "List of Schemes with <=15 LPCD supply over the Week",
      "emptyText": "None",
      "columns": [
        { "field": "SERIAL_NO", "label": "S. No.", "width": 8 },
        { "field": "SCHEME_NAME", "label": "Scheme Name", "width": 40 },
        { "field": "PUMP_OPERATOR_NAMES", "label": "Jal Mitra", "width": 28 },
        { "field": "PUMP_OPERATOR_MOBILES", "label": "Jal Mitra Phone Number", "width": 24 }
      ]
    }
  ],
  "footer": [
    { "type": "SUPPORT_CONTACT", "text": "For support, contact {supportPhone}" }
  ]
}
