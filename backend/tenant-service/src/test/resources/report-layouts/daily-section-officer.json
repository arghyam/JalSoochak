{
  "numberSections": true,
  "header": [
    { "type": "TITLE", "text": "Daily Water Service Situation Report" },
    { "type": "SUBTITLE", "text": "(Auto generated by JalSoochak)" },
    { "type": "SPACER" },
    { "type": "FIELD", "label": "Section-Officer: ", "value": "{officerName}" },
    { "type": "FIELD", "label": "Date: ", "value": "{reportDate}" },
    { "type": "FIELD", "label": "Reporting Period: ", "value": "00:00 hrs – {cutoff} hrs" },
    { "type": "SPACER" },
    { "type": "DASHBOARD_LINK", "prefix": "Visit JalSoochak Dashboard at ", "suffix": " for more insights" }
  ],
  "sections": [
    {
      "type": "SUMMARY",
      "title": "Summary",
      "columns": [
        { "field": "LABEL", "label": "Parameters", "width": 62 },
        { "field": "VALUE", "label": "Today (Up to {cutoff})", "width": 38 }
      ],
      "rows": [
        { "kpi": "TOTAL_SCHEMES", "label": "Total Schemes (Handed Over Schemes only)" },
        { "kpi": "SCHEMES_SUPPLYING", "label": "Schemes Supplying Water" },
        { "kpi": "SCHEMES_NOT_SUPPLYING", "label": "Schemes Not having supplied Water (Till {cutoff})" },
        { "kpi": "HOUSEHOLDS_WITH_SUPPLY", "label": "Number of HHs with water supply TODAY" },
        { "kpi": "HOUSEHOLDS_WITHOUT_SUPPLY", "label": "Number of HHs yet to get water supply" },
        { "kpi": "AVG_LPCD", "label": "Average LPCD*" },
        { "kpi": "ANOMALOUS_SUBMISSIONS", "label": "Number of Anomalous Submissions" }
      ],
      "footnotes": [
        "* of schemes that have supplied water"
      ]
    },
    {
      "type": "SCHEME_LIST",
      "list": "NO_SUPPLY",
      "title": "Scheme with No Water Supply",
      "emptyText": "None",
      "columns": [
        { "field": "CENTRE_SCHEME_ID", "label": "Scheme IMIS Id", "width": 21 },
        { "field": "SCHEME_NAME", "label": "Scheme Name", "width": 33 },
        { "field": "PUMP_OPERATOR_NAMES", "label": "Jal Mitra Name", "width": 26 },
        { "field": "PUMP_OPERATOR_MOBILES", "label": "Mobile No.", "width": 20 }
      ]
    },
    {
      "type": "SCHEME_LIST",
      "list": "ANOMALIES",
      "title": "Schemes with Anomalous Submissions",
      "emptyText": "None",
      "columns": [
        { "field": "CENTRE_SCHEME_ID", "label": "Scheme IMIS Id", "width": 20 },
        { "field": "SCHEME_NAME", "label": "Scheme Name", "width": 20 },
        { "field": "ANOMALY_TYPE", "label": "Type of Anomaly in Submission", "width": 23 },
        { "field": "PUMP_OPERATOR_NAMES", "label": "Jal Mitra Name", "width": 20 },
        { "field": "PUMP_OPERATOR_MOBILES", "label": "Mobile No.", "width": 17 }
      ]
    }
  ],
  "footer": [
    { "type": "SUPPORT_CONTACT", "text": "For support, contact {supportPhone}" }
  ]
}
